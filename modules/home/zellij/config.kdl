// Zellij Configuration for zcli-server
theme "pure-black"
default_layout "compact"
mouse_mode true
copy_on_select true

themes {
    pure-black {
        fg "#c0caf5"
        bg "#000000"
        black "#000000"
        red "#f7768e"
        green "#9ece6a"
        yellow "#e0af68"
        blue "#7aa2f7"
        magenta "#bb9af7"
        cyan "#7dcfff"
        white "#c0caf5"
        orange "#ff9e64"
    }
}

keybinds {
    normal {
        bind "Alt z" { SwitchToMode "Locked"; }
    }
}
